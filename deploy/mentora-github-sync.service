[Unit]
Description=Deploy Mentora from GitHub main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/.local/lib/mentora-deploy/auto_deploy.py
TimeoutStartSec=30min
UMask=0077
