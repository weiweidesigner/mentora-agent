# Execution framework: deepseek (default) or codex. Restart after changing.
AICHART_REASONING_FRAMEWORK=deepseek

# DeepSeek Harness
DEEPSEEK_API_KEY=
AICHART_FLUX_TRANSLATOR_PROVIDER=auto
AICHART_FLUX_REMOTE_TRANSLATOR_MODEL=
AICHART_FLUX_TRANSLATOR_BASE_URL=
AICHART_FLUX_TRANSLATOR_MODEL=glm4:9b
# 与本机 DeepSeek Harness Web UI 共用 session 仓库
DSH_HOME=~/.dsh
DSH_BIN=
AICHART_DEEPSEEK_SDK_PATH=
AICHART_DEEPSEEK_PROVIDER=deepseek-official
AICHART_DEEPSEEK_MODEL=deepseek-v4-flash
AICHART_DEEPSEEK_TIMEOUT_SECONDS=1200
AICHART_DEEPSEEK_RUN_TIMEOUT_SECONDS=600

# Optional native StreamViz mode. This uses an OpenAI-compatible model with
# function calling and streams its visualize_show_widget arguments directly to
# the browser. Falls back to DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL if omitted.
AICHART_STREAMVIZ_API_KEY=
AICHART_STREAMVIZ_BASE_URL=https://api.deepseek.com
AICHART_STREAMVIZ_MODEL=deepseek-chat

# Optional local Ollama model for direct API/developer use.
AICHART_OLLAMA_URL=http://127.0.0.1:11434
AICHART_OLLAMA_MODEL=haervwe/GLM-4.6V-Flash-9B:latest
AICHART_OLLAMA_API_KEY=ollama
AICHART_OLLAMA_TIMEOUT_SECONDS=600

# Codex. Uses the logged-in local CLI by default.
AICHART_CODEX_BIN=codex
AICHART_CODEX_MODEL=
AICHART_CODEX_NETWORK_ACCESS=true
AICHART_CODEX_RUN_TIMEOUT_SECONDS=1200
AICHART_CODEX_OLLAMA_MODEL=aimechart/glm-4.6v-flash-9b-codex:latest
AICHART_CODEX_GLM_ADAPTER_URL=http://127.0.0.1:8010/local-glm/v1
AICHART_CODEX_OLLAMA_CONTEXT_WINDOW=16384
AICHART_CODEX_OLLAMA_COMPACT_TOKEN_LIMIT=12288

# WeCom group robot. Keep the real webhook URL only in .env.
WECOM_BOT_WEBHOOK_URL=
# Local address used by Playwright when rendering a WeCom image.
AICHART_LOCAL_BASE_URL=http://127.0.0.1:8000

# Existing tool credentials
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL_NAME=deepseek-v4-flash-vision-exp
VISION_IMAGE_DETAIL=original
ARK_API_KEY=
MOONSHOT_API_KEY=
AINVEST_COOKIE=
FUYAO_API_KEY=

# Internal APISIX route used by the My List batch-add tool. Keep the real
# caller key in .env/deployment secrets; it is added as the `apikey` header.
AINVEST_WATCHLIST_UGC_ENDPOINT=http://mobileweb-ugc-facade-service/optdata/ugc_facade/open/api/v1/watchlist
AINVEST_WATCHLIST_APIKEY=
AICHART_FLUX_RUNNER=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_ACTIVITY_ROUTING_ENABLED=true
TYPESAFE_ACTIVITY_TIMEOUT_SECONDS=3
TYPESAFE_VISUAL_PRIMARY_MIN_CONFIDENCE=0.35
TYPESAFE_VISUAL_SUPPORTING_MIN_CONFIDENCE=0.55

# Local-only credentials and paths for repository-backed visual skills.
VISION_API_KEY=
VISION_CONFIG_FILE=
AICHART_PROJECT_ROOT=
AICHART_FLUX2_RUNNER=

# Optional AutoGen Studio integration; keep machine paths in local .env.
AUTOGEN_STUDIO_DB_PATH=
AUTOGEN_STUDIO_ARTIFACT_ROOT=
AUTOGEN_STUDIO_SESSION_NAME="Veya · AgentChat"

# URL prefix used by a reverse proxy; empty for local root deployments.
AICHART_BASE_PATH=
