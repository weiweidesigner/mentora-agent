d-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:16px;align-items:start}.veya-report .ranking-item{display:grid;gap:8px}.veya-report .name-code{display:block;font-size:11px;color:var(--sv-text-secondary)}.veya-report .wide-table{min-width:560px}.veya-report .section-summary b{color:var(--sv-text-primary)}@media(max-width:420px){.veya-report .distribution-row{grid-template-columns:78px minmax(0,1fr) 100px;font-size:11px}}\n.veya-report .ratio-inline{display:grid;grid-template-columns:minmax(80px,1fr) 48px;gap:8px;align-items:center;min-width:160px}.veya-report .ratio-track{display:block;height:8px;background:var(--sv-surface-secondary)}.veya-report .ratio-fill{display:block;height:100%;background:var(--sv-chart-series-1);border-radius:0 2px 2px 0}.veya-report .ratio-text{text-align:right}</style><article class=\"veya-report\" data-financial-market=\"CN\" data-sv-layout=\"stack\">\n<header class=\"card\"><p class=\"eyebrow\">A 股收盘复盘 · 2026-10-13（北京时间）</p><h1>指数分化，个股温和偏强：<br>市场宽度好于指数表现</h1><p class=\"muted\">上证微涨，深证与创业板指小幅收跌；但全市场 2909 家上涨、2485 家下跌，个股涨跌幅中位数为 +0.16%。成交回暖至约 1.69 万亿元，板块间仍有明显分化。</p><div class=\"chips\"><span class=\"chip\">上涨家数占比 52.3%</span><span class=\"chip\">较前一交易日放量约 1380 亿元</span><span class=\"chip\">科创板、北交所中位数收负</span></div></header>\n<section class=\"card\"><h2>指数对照 · 收盘</h2><p class=\"section-summary\">指数与个股体感分化：沪指微涨，深证成指与创业板指收跌。</p><div class=\"table-scroll\"><table aria-label=\"主要指数收盘点位与涨跌幅\"><thead><tr><th>指数</th><th>收盘点位</th><th>当日涨跌幅</th></tr></thead><tbody><tr><td>上证指数</td><td>3,800.86</td><td class=\"up\"><b>+0.10%</b></td></tr><tr><td>深证成指</td><td>12,353.70</td><td class=\"down\"><b>−0.25%</b></td></tr><tr><td>创业板指</td><td>2,958.34</td><td class=\"down\"><b>−0.18%</b></td></tr></tbody></table></div><p class=\"source-note\">指数点位来自公开行情与媒体复盘交叉核对；非交易所接口直取。Yahoo 指数接口限流，本页不以近似标的替代指数走势图。</p></section>\n<section class=\"card\"><h2>市场宽度 · 上涨家数略占优势</h2><p class=\"section-summary\">5560 只有效样本中，上涨比下跌多 424 家；家数占优不代表每只股票都上涨。</p><div class=\"breadth\" role=\"img\" aria-label=\"上涨2909家52.32%，平盘166家2.99%，下跌2485家44.69%\"><span style=\"width:52.32014388%;background:var(--sv-price-up)\"></span><span style=\"width:2.98561151%;background:var(--sv-price-flat)\"></span><span style=\"width:44.69424460%;background:var(--sv-price-down)\"></span></div><div class=\"legend\"><span><i style=\"background:var(--sv-price-up)\"></i>上涨 2909 家 · 52.32%</span><span><i style=\"background:var(--sv-price-flat)\"></i>平盘 166 家 · 2.99%</span><span><i style=\"background:var(--sv-price-down)\"></i>下跌 2485 家 · 44.69%</span></div><div class=\"metrics\"><div class=\"insight\" data-sv-metric><span class=\"stat-label\">涨跌家数比</span><strong class=\"stat-value\">1.17</strong><span class=\"stat-note\">净上涨 +424 家</span></div><div class=\"insight\" data-sv-metric><span class=\"stat-label\">个股涨跌幅中位数</span><strong class=\"stat-value up\">+0.16%</strong><span class=\"stat-note\">逐股快照自算</span></div><div class=\"insight\" data-sv-metric><span class=\"stat-label\">全市场成交额</span><strong class=\"stat-value\">1.69 万亿</strong><span class=\"stat-note\">沪深京自算 16889 亿元</span></div><div class=\"insight\" data-sv-metric><span class=\"stat-label\">涨停 / 跌停</span><strong class=\"stat-value\">70 / 10</strong><span class=\"stat-note\">媒体复盘口径</span></div><div class=\"insight\" data-sv-metric><span class=\"stat-label\">个股振幅中位数</span><strong class=\"stat-value\">4.93%</strong><span class=\"stat-note\">（最高−最低）/ 前收</span></div></div></section>\n<div data-sv-layout=\"grid\" style=\"align-items:start\"><section class=\"card\"><h2>板块分化 · 创业板个股更强</h2><p class=\"section-summary\">对照各板块个股涨跌幅中位数；与市值加权指数的口径不同。</p><div role=\"img\" aria-label=\"创业板+0.44%，深市主板+0.27%，沪市主板+0.17%，科创板−0.39%，北交所−0.60%\"><div class=\"bar-row\"><span>创业板</span><div class=\"bar-track\"><div class=\"bar-half\"></div><div class=\"bar-half\"><span class=\"bar-fill positive\" style=\"width:73.33%\"></span></div></div><b class=\"bar-value up\">+0.44%</b></div><div class=\"bar-row\"><span>深市主板</span><div class=\"bar-track\"><div class=\"bar-half\"></div><div class=\"bar-half\"><span class=\"bar-fill positive\" style=\"width:45.00%\"></span></div></div><b class=\"bar-value up\">+0.27%</b></div><div class=\"bar-row\"><span>沪市主板</span><div class=\"bar-track\"><div class=\"bar-half\"></div><div class=\"bar-half\"><span class=\"bar-fill positive\" style=\"width:28.33%\"></span></div></div><b class=\"bar-value up\">+0.17%</b></div><div class=\"bar-row\"><span>科创板</span><div class=\"bar-track\"><div class=\"bar-half\"><span class=\"bar-fill negative\" style=\"width:65.00%\"></span></div><div class=\"bar-half\"></div></div><b class=\"bar-value down\">-0.39%</b></div><div class=\"bar-row\"><span>北交所</span><div class=\"bar-track\"><div class=\"bar-half\"><span class=\"bar-fill negative\" style=\"width:100.00%\"></span></div><div class=\"bar-half\"></div></div><b class=\"bar-value down\">-0.60%</b></div></div><p class=\"source-note\">创业板上涨占比 59.1%；科创板 41.3%，北交所 33.8%。图形以零轴为中心，左右长度同一比例。</p></section><section class=\"card\"><h2>行业强弱 · 军工与通信领先</h2><p class=\"section-summary\">申万一级行业，机构复盘口径。</p><div class=\"table-scroll\"><table aria-label=\"主要领涨领跌行业\"><tbody><tr><td>国防军工</td><td class=\"up\">+2.69%</td></tr><tr><td>通信</td><td class=\"up\">+1.78%</td></tr><tr><td>综合</td><td class=\"up\">+1.46%</td></tr><tr><td>非银金融</td><td class=\"down\">−0.98%</td></tr><tr><td>汽车</td><td class=\"down\">−0.99%</td></tr><tr><td>电力设备</td><td class=\"down\">−2.01%</td></tr></tbody></table></div><p class=\"source-note\">行业数据来自二手复盘，非交易所直连；用于呈现结构差异。</p></section></div>\n<section class=\"card\"><h2>涨跌分布 · 大多数个股集中在 ±3%</h2><p class=\"section-summary\">逐股涨跌幅分为 13 个区间，柱长表示家数。</p><div class=\"distribution-row\"><span>低于 −9.8%</span><div class=\"distribution-track\"><span class=\"distribution-fill\" style=\"width:1.0033%;background:var(--sv-price-down)\"></span></div><span class=\"distribution-value\">12 家 · 0.22%</span></div><div class=\"distribution-row\"><span>−9.8% ~ −7%</span><div class=\"distribution-t